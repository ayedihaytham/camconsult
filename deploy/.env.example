# Copiez ce fichier en .env dans le même dossier sur le VPS (à côté de
# docker-compose.yml). NE JAMAIS committer .env.

DB_PASSWORD=CHANGE_MOI_mot_de_passe_fort

# Générez avec : openssl rand -hex 48
JWT_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_LONG

ADMIN_IDENTIFIANT=mohamed.ayedi
ADMIN_PASSWORD=CHANGEZ_MOI_avant_le_premier_lancement
ADMIN_NOM=Mohamed Ayedi
ADMIN_ROLE=Expert-comptable — Responsable du cabinet

# Extraction des pièces du module Stock par un modèle de vision (plus d'OCR
# local) : Claude (API Anthropic, clé sur console.anthropic.com) pour les
# sociétés non couvertes par le moteur RUSPINA. Sans clé, l'import automatique
# est refusé (saisie à la main).
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_EXTRACT_MODEL=claude-sonnet-5-5

# Facultatif — envoi d'emails réel (SMTP), ex. email de bienvenue à la
# création d'une société. Boîte mail créée côté hébergeur du domaine ;
# host/port exacts dans cPanel → Comptes de messagerie → Connect Devices.
# SMTP_HOST=mail.camconsult.com.tn
# SMTP_PORT=465
# SMTP_USER=contact@camconsult.com.tn
# SMTP_PASSWORD=
# SMTP_FROM=CAMCONSULT <contact@camconsult.com.tn>
