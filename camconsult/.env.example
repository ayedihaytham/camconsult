# URL de connexion de l'app comptable (bouton « Espace client » + redirection
# de /espace-client). Copiez ce fichier en .env.local pour le dev, ou en .env
# sur le serveur de production.
NEXT_PUBLIC_CLIENT_PORTAL_URL=https://cabinet.camconsult.com.tn/login

# Origine canonique du site vitrine, sans chemin /fr, /en ou /ar.
# Ces paramètres SEO sont lus au build : reconstruire après modification.
SITE_URL=https://camconsult.com.tn
# Production : true. Préproduction / aperçu : false.
SITE_INDEXABLE=true
# Facultatifs : uniquement la valeur « content » de la balise de vérification.
# Inutiles si vous utilisez la vérification DNS recommandée.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
