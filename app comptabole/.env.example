# Copiez ce fichier en .env et ajustez si besoin.

# Connexion PostgreSQL (le docker-compose fourni écoute sur 5439)
DATABASE_URL=postgres://cabinet:cabinet@localhost:5439/cabinet

# Development seeds are disabled by default. Only enable for a local development database.
ALLOW_DB_SEED=false

# Port de l'API Node
API_PORT=5181

# Secret de signature des jetons JWT (changez-le en production)
JWT_SECRET=dev-secret-change-me

# Identifiants du compte administrateur créés au premier démarrage
ADMIN_IDENTIFIANT=mohamed.ayedi
ADMIN_PASSWORD=Cabinet2026!
ADMIN_NOM=Mohamed Ayedi
ADMIN_ROLE=Expert-comptable — Responsable du cabinet

# Import OCR "document complet" (module Stock) : extraction par Claude
# (Sonnet 5) au lieu de l'OCR local (tesseract) — bien plus fiable sur les
# documents denses/bilingues (ex. déclarations douanières). Facultatif : sans
# cette clé, l'appli retombe automatiquement sur l'OCR local gratuit.
# Clé sur console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-...

# Envoi d'emails (SMTP) — facultatif : sans ces variables, l'appli saute
# l'envoi silencieusement (ex. email de bienvenue à la création d'une
# société). Boîte mail créée chez l'hébergeur du domaine (cPanel → Comptes
# de messagerie) ; host/port exacts visibles dans cPanel → « Connect Devices »
# pour cette boîte.
# SMTP_HOST=mail.camconsult.com.tn
# SMTP_PORT=465
# SMTP_USER=contact@camconsult.com.tn
# SMTP_PASSWORD=
# SMTP_FROM=CAMCONSULT <contact@camconsult.com.tn>
