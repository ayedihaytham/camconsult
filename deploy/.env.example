# Générez avec : openssl rand -hex 48
JWT_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_LONG

ADMIN_IDENTIFIANT=mohamed.ayedi
ADMIN_PASSWORD=CHANGEZ_MOI_avant_le_premier_lancement
